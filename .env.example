# Supabase Project Settings > API Keys. The publishable key is designed for browser use;
# database row-level security and server-side role policies are still required.
# Leave both values blank for synthetic Demo and protected Preview builds.
# Set both for an approved Production build. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable live import actions only for an approved, configured environment.
VITE_ENABLE_LIVE_IMPORTS=false
