# Supabase Project Settings > API Keys. The publishable key is designed for browser use;
# database row-level security and server-side role policies are still required.
# Leave both values blank for synthetic Demo and protected Preview builds.
# Set both for an approved Production build. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable live import actions only for an approved, configured environment.
VITE_ENABLE_LIVE_IMPORTS=false
# Opt in for Executive Preview. The redesigned production host also requires PEOPLEPULSE_REDESIGN_SAMPLE=true.
VITE_EXECUTIVE_SAMPLE_MODE=false
# Send password-reset users to the configured original PeoplePulse host on the redesigned site.
VITE_USE_ORIGINAL_PASSWORD_RESET=false
# Set PEOPLEPULSE_STANDALONE_SAMPLE=true in the build environment of the separate sample site only.
